## ==========================================
## Sepsis Early Warning System — .gitignore
## Covers: Python/FastAPI backend, ML models,
## data files, React frontend, env & IDE files
## ==========================================

## ---------- Environment / Secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
config/secrets.*

## ---------- Python (Backend) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

## ---------- ML Models & Artifacts ----------
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors
models/*.bin
checkpoints/
runs/
mlruns/
wandb/
lightning_logs/

## ---------- Data (Patient / PHI Safety) ----------
# Never commit real or de-identified patient data.
data/
datasets/
*.csv
*.tsv
*.parquet
*.xlsx
*.json
!package.json
!package-lock.json
!tsconfig.json
!*.config.json
!frontend/src/**/*.json

## ---------- Node / React (Frontend) ----------
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
frontend/build/
frontend/dist/
build/
dist/

# Vite / CRA caches
.cache/
.parcel-cache/
.vite/

## ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~

## ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

## ---------- Logs ----------
*.log
logs/

## ---------- Misc ----------
.cache
tmp/
temp/
*.tmp